generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Household {
  id           BigInt      @id @default(autoincrement()) @db.BigInt
  name         String      @unique
  weekStartsOn Int         @default(0) @map("week_starts_on") @db.SmallInt
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  users        User[]
  weekDays     WeekDay[]
  meals        Meal[]
  thawRules    ThawRule[]
  mealEntries  MealEntry[]
  stagedMeals  StagedMeal[]
  mealHistory  MealHistory[]
  reminders    Reminder[]
  invites      HouseholdInvite[]

  @@map("households")
}

model User {
  id          BigInt    @id @default(autoincrement()) @db.BigInt
  householdId BigInt    @map("household_id") @db.BigInt
  username    String?   @unique
  email       String    @unique
  passwordHash String?  @map("password_hash")
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(6)
  failedLoginAttempts Int @default(0) @map("failed_login_attempts")
  lockedUntil DateTime? @map("locked_until") @db.Timestamptz(6)
  displayName String    @map("display_name")
  role        String    @default("member")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  mealEntries MealEntry[] @relation("MealEntryCreatedBy")
  stagedMeals StagedMeal[] @relation("StagedMealCreatedBy")
  verificationTokens EmailVerificationToken[]
  passwordResetTokens PasswordResetToken[]
  sentInvites HouseholdInvite[] @relation("InviteSentBy")
  acceptedInvites HouseholdInvite[] @relation("InviteAcceptedBy")

  @@map("users")
}

model EmailVerificationToken {
  id        BigInt    @id @default(autoincrement()) @db.BigInt
  userId    BigInt    @map("user_id") @db.BigInt
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt], map: "idx_email_verification_user_expires")
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        BigInt    @id @default(autoincrement()) @db.BigInt
  userId    BigInt    @map("user_id") @db.BigInt
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt], map: "idx_password_reset_user_expires")
  @@map("password_reset_tokens")
}

model HouseholdInvite {
  id          BigInt    @id @default(autoincrement()) @db.BigInt
  householdId BigInt    @map("household_id") @db.BigInt
  email       String
  role        String    @default("member")
  tokenHash   String    @unique @map("token_hash")
  invitedById BigInt?   @map("invited_by_id") @db.BigInt
  acceptedById BigInt?  @map("accepted_by_id") @db.BigInt
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(6)
  acceptedAt  DateTime? @map("accepted_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  invitedBy   User?     @relation("InviteSentBy", fields: [invitedById], references: [id], onDelete: SetNull)
  acceptedBy  User?     @relation("InviteAcceptedBy", fields: [acceptedById], references: [id], onDelete: SetNull)

  @@index([householdId, email], map: "idx_household_invites_household_email")
  @@index([householdId, expiresAt], map: "idx_household_invites_household_expires")
  @@map("household_invites")
}

model WeekDay {
  id          BigInt     @id @default(autoincrement()) @db.BigInt
  householdId BigInt     @map("household_id") @db.BigInt
  dayDate     DateTime   @map("day_date") @db.Date
  nightType   String     @default("normal") @map("night_type")
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime   @default(now()) @map("updated_at") @db.Timestamptz(6)
  household   Household  @relation(fields: [householdId], references: [id], onDelete: Cascade)
  mealEntry   MealEntry?

  @@unique([householdId, dayDate])
  @@index([householdId, dayDate], map: "idx_week_days_household_date")
  @@map("week_days")
}

model Meal {
  id          BigInt     @id @default(autoincrement()) @db.BigInt
  householdId BigInt     @map("household_id") @db.BigInt
  name        String
  defaultNote String?    @map("default_note")
  active      Boolean    @default(true)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  household   Household  @relation(fields: [householdId], references: [id], onDelete: Cascade)
  mealEntries MealEntry[]
  stagedMeals StagedMeal[]

  @@unique([householdId, name])
  @@map("meals")
}

model ThawRule {
  id          BigInt     @id @default(autoincrement()) @db.BigInt
  householdId BigInt     @map("household_id") @db.BigInt
  name        String
  leadDays    Int        @map("lead_days")
  active      Boolean    @default(true)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  household   Household  @relation(fields: [householdId], references: [id], onDelete: Cascade)
  mealEntries MealEntry[]

  @@unique([householdId, name])
  @@map("thaw_rules")
}

model MealEntry {
  id          BigInt      @id @default(autoincrement()) @db.BigInt
  householdId BigInt      @map("household_id") @db.BigInt
  weekDayId   BigInt      @unique @map("week_day_id") @db.BigInt
  dayDate     DateTime    @map("day_date") @db.Date
  mealId      BigInt?     @map("meal_id") @db.BigInt
  mealName    String      @map("meal_name")
  notes       String?
  thawReminderLabel String? @map("thaw_reminder_label")
  thawLeadDays Int? @map("thaw_lead_days") @db.SmallInt
  thawRuleId  BigInt?     @map("thaw_rule_id") @db.BigInt
  createdBy   BigInt?     @map("created_by") @db.BigInt
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime    @default(now()) @map("updated_at") @db.Timestamptz(6)
  household   Household   @relation(fields: [householdId], references: [id], onDelete: Cascade)
  weekDay     WeekDay     @relation(fields: [weekDayId], references: [id], onDelete: Cascade)
  meal        Meal?       @relation(fields: [mealId], references: [id], onDelete: SetNull)
  thawRule    ThawRule?   @relation(fields: [thawRuleId], references: [id], onDelete: SetNull)
  creator     User?       @relation("MealEntryCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  history     MealHistory[]
  reminders   Reminder[]

  @@map("meal_entries")
}

model StagedMeal {
  id            BigInt    @id @default(autoincrement()) @db.BigInt
  householdId   BigInt    @map("household_id") @db.BigInt
  mealId        BigInt?   @map("meal_id") @db.BigInt
  mealName      String    @map("meal_name")
  preferredDate DateTime? @map("preferred_date") @db.Date
  notBeforeDate DateTime? @map("not_before_date") @db.Date
  note          String?
  status        String    @default("staged")
  createdBy     BigInt?   @map("created_by") @db.BigInt
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  household     Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  meal          Meal?     @relation(fields: [mealId], references: [id], onDelete: SetNull)
  creator       User?     @relation("StagedMealCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([householdId, status], map: "idx_staged_household_status")
  @@map("staged_meals")
}

model MealHistory {
  id          BigInt    @id @default(autoincrement()) @db.BigInt
  householdId BigInt    @map("household_id") @db.BigInt
  mealEntryId BigInt    @map("meal_entry_id") @db.BigInt
  mealName    String    @map("meal_name")
  occurredOn  DateTime  @map("occurred_on") @db.Date
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  mealEntry   MealEntry @relation(fields: [mealEntryId], references: [id], onDelete: Cascade)

  @@unique([householdId, mealEntryId])
  @@index([householdId, occurredOn], map: "idx_history_household_date")
  @@map("meal_history")
}

model Reminder {
  id              BigInt     @id @default(autoincrement()) @db.BigInt
  householdId     BigInt     @map("household_id") @db.BigInt
  mealEntryId     BigInt?    @map("meal_entry_id") @db.BigInt
  reminderType    String     @default("thaw") @map("reminder_type")
  dueAt           DateTime   @map("due_at") @db.Timestamptz(6)
  message         String
  status          String     @default("pending")
  sentAt          DateTime?  @map("sent_at") @db.Timestamptz(6)
  deliveryChannel String     @default("in_app") @map("delivery_channel")
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  household       Household  @relation(fields: [householdId], references: [id], onDelete: Cascade)
  mealEntry       MealEntry? @relation(fields: [mealEntryId], references: [id], onDelete: Cascade)

  @@index([householdId, dueAt], map: "idx_reminders_household_due")
  @@map("reminders")
}
